# Flask Environment Configuration — EXAMPLE
# Copy this file to .env and fill in your values.
# DO NOT commit .env — only commit .env.example

FLASK_APP=wsgi.py
FLASK_ENV=development

# Generate a strong random secret key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret-key

# ── Database ──────────────────────────────────────────────────────────────────
# Leave unset for local SQLite (config.py auto-configures instance/inventory.db)
# Uncomment for local PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/inventory_dev
#
# On Render: DATABASE_URL is injected automatically via render.yaml — do not set manually.
